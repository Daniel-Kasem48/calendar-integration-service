{
  "name": "calendar-integration-service",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Google Calendar and Outlook Calendar integration with a NestJS / Apollo GraphQL API.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm test"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/graphql": "^14.2.0",
    "@nestjs/platform-express": "^12.4.0",
    "graphql": "^16.11.0",
    "moment-timezone": "^0.6.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
